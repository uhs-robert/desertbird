{
  "name": "desertbird",
  "version": "0.0.0",
  "private": true,
  "description": "Keyboard-first Thunderbird add-on.",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node tools/build.mjs",
    "lint": "eslint",
    "unit": "node --no-warnings tools/check_unit_count.ts",
    "unit:file": "node --test --test-timeout=30000 --no-warnings",
    "test": "npm run --silent check",
    "e2e": "node tools/e2e/run.mjs",
    "e2e:flakes": "node tools/e2e/flakes.mjs run",
    "e2e:weights": "node tools/e2e/shards.mjs write-weights",
    "docs:gen": "node --no-warnings tools/gen-keymap-docs.ts --write",
    "docs:check": "node --no-warnings tools/gen-keymap-docs.ts --check",
    "defaults:check": "node tools/check_default_settings.ts",
    "check": "npm run --silent docs:check && npm run --silent lint && npm run --silent typecheck && npm run --silent unit && npm run --silent defaults:check"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2"
  }
}
