[
  {
    "namespace": "overlay",
    "description": "A page of the extension shown over the main mail window: the command line, the panel for which-key and toasts, and the mode label in the status bar. The page name comes from a fixed list and the parent maps it to a page of the extension.",
    "functions": [
      {
        "name": "mount",
        "type": "function",
        "async": true,
        "description": "Shows the surface in the window and gives it the focus. A second call for the same window replaces the first.",
        "parameters": [
          {
            "name": "args",
            "type": "object",
            "properties": {
              "windowId": {
                "type": "integer",
                "minimum": 0
              },
              "surface": {
                "type": "string",
                "enum": ["cmdline", "hud"]
              },
              "clickThrough": {
                "type": "boolean",
                "optional": true
              }
            }
          }
        ]
      },
      {
        "name": "unmount",
        "type": "function",
        "async": true,
        "description": "Removes the overlay of the window and returns the focus to the thread list. Does nothing when none is mounted.",
        "parameters": [
          {
            "name": "args",
            "type": "object",
            "properties": {
              "windowId": {
                "type": "integer",
                "minimum": 0
              },
              "surface": {
                "type": "string",
                "enum": ["cmdline", "hud"]
              }
            }
          }
        ]
      },
      {
        "name": "setModeLabel",
        "type": "function",
        "async": true,
        "description": "Shows the mode label at the start of the status bar of the window, or removes it when the indicator is off. The parent turns the mode into insert while a text field has the focus, applies the indicator, maps the mode and the style to the text, and takes the colors from the scheme Thunderbird shows.",
        "parameters": [
          {
            "name": "args",
            "type": "object",
            "properties": {
              "windowId": {
                "type": "integer",
                "minimum": 0
              },
              "mode": {
                "type": "string",
                "enum": ["normal", "visual"]
              },
              "indicator": {
                "type": "string",
                "enum": ["always", "not_normal", "off"]
              },
              "style": {
                "type": "string",
                "enum": ["classic", "badge"]
              },
              "colors": {
                "type": "object",
                "description": "The label colors as #rrggbb for each color scheme: one per mode, and the text on a badge. The parent uses the scheme Thunderbird itself shows.",
                "properties": {
                  "dark": {
                    "type": "object",
                    "properties": {
                      "normal": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
                      "visual": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
                      "insert": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
                      "on_badge": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
                    }
                  },
                  "light": {
                    "type": "object",
                    "properties": {
                      "normal": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
                      "visual": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
                      "insert": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
                      "on_badge": { "type": "string", "pattern": "^#[0-9a-f]{6}$" }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onClosed",
        "type": "function",
        "description": "A surface left a window by itself: the front tab changed or the window closed. The payload is output only, so it takes no argument check.",
        "parameters": [
          {
            "name": "closed",
            "type": "object",
            "properties": {
              "windowId": {
                "type": "integer"
              },
              "surface": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "optional": true
              }
            }
          }
        ]
      }
    ]
  }
]
