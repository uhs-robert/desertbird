[
  {
    "namespace": "app",
    "description": "Thread list, pane focus and app verbs. The script loads when the first verb is called.",
    "functions": [
      {
        "name": "viewRows",
        "type": "function",
        "async": true,
        "description": "Reads the thread list rows from first to last: index, message id, depth, collapsed, unread and the message flags word, and the current row.",
        "parameters": [
          {
            "name": "args",
            "type": "object",
            "properties": {
              "windowId": {
                "type": "integer"
              },
              "first": {
                "type": "integer",
                "minimum": 0
              },
              "last": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        ]
      },
      {
        "name": "viewThread",
        "type": "function",
        "async": true,
        "description": "Opens or closes the thread at a row.",
        "parameters": [
          {
            "name": "args",
            "type": "object",
            "properties": {
              "windowId": {
                "type": "integer"
              },
              "row": {
                "type": "integer",
                "minimum": 0
              },
              "open": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      {
        "name": "viewAllThreads",
        "type": "function",
        "async": true,
        "description": "Opens or closes every thread.",
        "parameters": [
          {
            "name": "args",
            "type": "object",
            "properties": {
              "windowId": {
                "type": "integer"
              },
              "open": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      {
        "name": "viewScroll",
        "type": "function",
        "async": true,
        "description": "Scrolls a row to the middle, the top or the bottom of the list.",
        "parameters": [
          {
            "name": "args",
            "type": "object",
            "properties": {
              "windowId": {
                "type": "integer"
              },
              "row": {
                "type": "integer",
                "minimum": 0
              },
              "position": {
                "type": "string",
                "enum": [
                  "center",
                  "top",
                  "bottom"
                ]
              }
            }
          }
        ]
      },
      {
        "name": "paneFocus",
        "type": "function",
        "async": true,
        "description": "Moves the focus to the folder pane, the thread list or the message pane, or to the pane left or right of the focused one. Answers false, with the focus left where it was, when that pane is hidden, shows no message, or lies past the end.",
        "parameters": [
          {
            "name": "args",
            "type": "object",
            "properties": {
              "windowId": {
                "type": "integer"
              },
              "pane": {
                "type": "string",
                "enum": [
                  "folders",
                  "threads",
                  "message",
                  "left",
                  "right"
                ]
              }
            }
          }
        ]
      },
      {
        "name": "paneResize",
        "type": "function",
        "async": true,
        "description": "Moves the border of the focused pane in about:3pane by steps of 24 CSS pixels toward left, right, up or down, and stores the size as a drag does. With reset it gives both splitters their default sizes and removes the stored ones. Answers false, changing nothing, when the focused pane has no border on that axis or is collapsed. Never collapses a pane.",
        "parameters": [
          {
            "name": "args",
            "type": "object",
            "properties": {
              "windowId": {
                "type": "integer"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "left",
                  "right",
                  "up",
                  "down",
                  "reset"
                ]
              },
              "steps": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      },
      {
        "name": "appCommand",
        "type": "function",
        "async": true,
        "description": "Runs one of two Thunderbird commands by name. Answers false when Thunderbird has the command disabled.",
        "parameters": [
          {
            "name": "args",
            "type": "object",
            "properties": {
              "windowId": {
                "type": "integer"
              },
              "name": {
                "type": "string",
                "enum": [
                  "cmd_openConversation"
                ]
              }
            }
          }
        ]
      },
      {
        "name": "appOpenPage",
        "type": "function",
        "async": true,
        "description": "Opens one of three fixed pages in a tab. The parent holds the addresses.",
        "parameters": [
          {
            "name": "args",
            "type": "object",
            "properties": {
              "windowId": {
                "type": "integer"
              },
              "page": {
                "type": "string",
                "enum": [
                  "addons",
                  "themes",
                  "config"
                ]
              }
            }
          }
        ]
      }
    ]
  }
]
