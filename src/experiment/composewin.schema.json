[
  {
    "namespace": "composewin",
    "description": "Key handling in compose windows: one mode per window for the body and the address and subject fields, the field jumps, close and send. The chrome runtime matches keys locally and reports only the finished commands that run in the background.",
    "functions": [
      {
        "name": "install",
        "type": "function",
        "async": true,
        "description": "Installs the compiled compose keymap, or replaces the one installed. The first call starts the key listeners and later calls add none.",
        "parameters": [
          {
            "name": "args",
            "type": "object",
            "properties": {
              "composeTree": {
                "type": "object",
                "description": "The one loose object of the API, for the reason of `pages.install`: the compiled compose keymap as data, a version the parent checks and the root branch whose leaves name command ids. The parent runs a chrome leaf only when its id is in its fixed table (`compose.focus`, `compose.close`, `compose.send`).",
                "properties": {
                  "version": {
                    "type": "integer"
                  },
                  "root": {
                    "type": "any"
                  }
                },
                "additionalProperties": {
                  "type": "any"
                }
              },
              "allowSend": {
                "type": "boolean",
                "description": "Whether the send key may run Thunderbird's send command. The `compose_send` setting, off by default."
              },
              "labelStyle": {
                "type": "string",
                "enum": [
                  "classic",
                  "badge"
                ],
                "description": "How the mode label draws: colored text or a colored badge. The `mode_indicator_style` setting."
              },
              "labelColors": {
                "type": "object",
                "description": "The label colors as #rrggbb for each color scheme, from the theme. The parent uses the scheme Thunderbird itself shows.",
                "properties": {
                  "dark": {
                    "type": "object",
                    "properties": {
                      "normal": {
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      },
                      "visual": {
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      },
                      "insert": {
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      },
                      "resize": {
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      },
                      "on_badge": {
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      }
                    }
                  },
                  "light": {
                    "type": "object",
                    "properties": {
                      "normal": {
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      },
                      "visual": {
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      },
                      "insert": {
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      },
                      "resize": {
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      },
                      "on_badge": {
                        "type": "string",
                        "pattern": "^#[0-9a-f]{6}$"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    ],
    "events": [
      {
        "name": "onInvocation",
        "type": "function",
        "description": "A key sequence in a compose window finished on a command that runs in the background. It also carries `pending` reports of the half-typed sequence (`keys`, `source`). The payload is output only, so it takes no argument check.",
        "parameters": [
          {
            "name": "invocation",
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "object",
                "additionalProperties": {
                  "type": "any"
                }
              },
              "count": {
                "type": "integer"
              },
              "windowId": {
                "type": "integer"
              },
              "messageIds": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "source": {
                "type": "string"
              }
            }
          }
        ]
      }
    ]
  }
]
