{
    "manifest_version": 2,
    "name": "DesertBird",
    "version": "0.0.0",
    "description": "Keyboard-first mail commands for Thunderbird.",
    "browser_specific_settings": {
        "gecko": {
            "id": "desertbird@uhs-robert",
            "strict_min_version": "153.0"
        }
    },
    "background": {
        "scripts": ["background.js"],
        "persistent": true
    },
    "permissions": ["accountsRead", "clipboardWrite", "compose", "messagesDelete", "messagesMove", "messagesRead", "notifications", "storage"],
    "experiment_apis": {
        "keys": {
            "schema": "experiment/keys.schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["keys"]],
                "script": "experiment/keys.js"
            }
        }
    }
}
