{
    "manifest_version": 2,
    "name": "DesertBird",
    "version": "0.0.0",
    "description": "Keyboard-first mail commands for Thunderbird.",
    "browser_specific_settings": {
        "gecko": {
            "id": "desertbird@uhs-robert",
            "strict_min_version": "153.0"
        }
    },
    "background": {
        "scripts": ["background.js"],
        "persistent": true
    },
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": true
    },
    "permissions": ["accountsFolders", "accountsRead", "alarms", "clipboardWrite", "compose", "messagesDelete", "messagesMove", "messagesRead", "messagesTagsList", "messagesUpdate", "notifications", "storage", "tabs"],
    "experiment_apis": {
        "keys": {
            "schema": "experiment/keys.schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["keys"]],
                "script": "experiment/keys.js"
            }
        },
        "overlay": {
            "schema": "experiment/overlay.schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["overlay"]],
                "script": "experiment/overlay.js"
            }
        }
    }
}
