{
    "manifest_version": 2,
    "name": "DesertBird",
    "version": "0.0.0",
    "description": "Keyboard-first mail commands for Thunderbird.",
    "browser_specific_settings": {
        "gecko": {
            "id": "desertbird@uhs-robert",
            "strict_min_version": "153.0"
        }
    },
    "background": {
        "scripts": ["vendor/turndown/turndown.js", "vendor/marked/marked.umd.js", "background.js"],
        "persistent": true
    },
    "icons": { "48": "icons/desertbird.svg", "96": "icons/desertbird.svg" },
    "browser_action": {
        "default_title": "DesertBird",
        "default_icon": "icons/desertbird.svg",
        "default_popup": "popup/popup.html",
        "default_windows": ["normal"],
        "allowed_spaces": ["mail", "default"]
    },
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": true
    },
    "permissions": ["accountsFolders", "accountsRead", "alarms", "clipboardWrite", "compose", "compose.save", "downloads", "messagesDelete", "messagesModify", "messagesMove", "messagesRead", "messagesTags", "messagesTagsList", "messagesUpdate", "nativeMessaging", "notifications", "storage", "tabs"],
    "message_display_scripts": [{ "js": ["content/message_display.js"] }],
    "experiment_apis": {
        "keys": {
            "schema": "experiment/keys.schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["keys"]],
                "script": "experiment/keys.js"
            }
        },
        "app": {
            "schema": "experiment/app.schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["app"]],
                "script": "experiment/app.js"
            }
        },
        "folderpane": {
            "schema": "experiment/folderpane.schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["folderpane"]],
                "script": "experiment/folderpane.js"
            }
        },
        "overlay": {
            "schema": "experiment/overlay.schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["overlay"]],
                "script": "experiment/overlay.js"
            }
        },
        "composewin": {
            "schema": "experiment/composewin.schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["composewin"]],
                "script": "experiment/composewin.js"
            }
        },
        "pages": {
            "schema": "experiment/pages.schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["pages"]],
                "script": "experiment/pages.js"
            }
        },
        "zoom": {
            "schema": "experiment/zoom.schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["zoom"]],
                "script": "experiment/zoom.js"
            }
        },
        "hints": {
            "schema": "experiment/hints.schema.json",
            "parent": {
                "scopes": ["addon_parent"],
                "paths": [["hints"]],
                "script": "experiment/hints.js"
            }
        }
    }
}
