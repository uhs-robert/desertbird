{
    "manifest_version": 2,
    "name": "DesertBird e2e helper",
    "version": "0.0.0",
    "description": "Test only. Reports mail state to the e2e result sink and reloads DesertBird on request.",
    "browser_specific_settings": { "gecko": { "id": "e2e-helper@desertbird.invalid", "strict_min_version": "128.0" } },
    "background": { "scripts": ["config.js", "background.js"], "persistent": true },
    "permissions": ["accountsRead", "management", "messagesRead", "messagesMove", "messagesDelete", "tabs", "compose", "http://127.0.0.1/*"]
}
