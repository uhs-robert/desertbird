{
  "manifest_version": 2,
  "name": "DesertBird measuring probe",
  "version": "0.0.1",
  "description": "Throwaway measuring code. It never ships.",
  "browser_specific_settings": { "gecko": { "id": "probe@desertbird.invalid", "strict_min_version": "153.0" } },
  "background": { "scripts": ["config.js", "background.js"] },
  "permissions": [
    "accountsRead", "accountsFolders", "messagesRead", "messagesMove", "messagesDelete", "messagesUpdate", "messagesTags", "messagesTagsList", "nativeMessaging",
    "messagesModify", "compose", "storage", "tabs", "clipboardWrite", "clipboardRead", "menus", "addressBooks", "http://127.0.0.1/*"
  ],
  "commands": { "probe-chord": { "suggested_key": { "default": "Alt+Shift+9" }, "description": "present only so the commands API loads" } },
  "experiment_apis": {
    "probe": {
      "schema": "experiment/schema.json",
      "parent": { "scopes": ["addon_parent"], "paths": [["probe"]], "script": "experiment/parent.js", "events": [] }
    }
  }
}
